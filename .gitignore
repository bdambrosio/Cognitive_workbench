# ROS2 build artifacts
build/
install/
log/

# Python virtual environment
ros_venv/
zenoh_venv/

# Benchmark snapshots (large binary state copies, per-experiment)
bench/snapshots/

# Benchmark per-run output (transcripts, raw/scored jsonl, summaries)
bench/*/results/

# Claims-audit run output. Derived from a model against an instrument state, not
# source: a checkout does not need it and it only grows. engagements/*/runs/ is
# already covered by the bare `runs/` rule below. Reports needed by tests are
# copied into tests/fixtures/audit_review/ instead.
measure/fixtures/dataroom/results/

# Benchmark scoring artifacts (judge outputs, aggregate.json) — regenerable
bench/*/scores*/

# Archive of bench-spawned scenario worlds moved out of scenarios/
bench/runs/

# Benchmark experiment output (per-goal JSONL + summary sidecars)
runs/

# Benchmark experiment sidecar state (world_model/cached_plan captures
# from Trial B/C runs used as Trial C overlay sources)
exp/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE files (optional - you might want to keep .vscode/)
# .vscode/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~

# ROS2 specific
*.db
*.db-*

# Cognitive framework data (private memories, etc.)
/data/
src/logs/llm_client.log
src/logs/memory_node.log
src/logs/situation_node.log
src/logs/llm_service_node.log
src/logs/map_node.log
src/logs/sense_node.log
src/logs/character_launcher.log
src/logs/executive_node.log
src/logs/fastapi_action_display.log
src/data/*
# Exception: track plan guidance data for version control
!src/data/planner_feedback/
!src/data/planner_feedback/plan_guidance.jsonl
src/logs/
*.log
src/logs/*.log
src/Metrics/analysis/*
zenoh_venv/bin/pip3

# Test evaluation scripts
tests/rfp_shredder_eval.py

# External bot reference (symlink to file outside workspace)
src/world-tools/minecraft/bot-reference/

# External dependencies (cloned repos)
src/world-tools/minecraft/voxel_affordance_model/

# Scenario resources (generated/runtime data)
scenarios/*/

# Musings (generated/runtime)
src/musings/
zenoh-venv/

# Misc files to ignore
bfg-1.14.0.jar
README.old
=6.0
.cursorrules
\#scratch\#
.wiki

# Goal plan edit and review files
goal_plan_*.py
goal_trace_*.txt
goal_review_*.md

# Runtime/temp state files
current_display.txt
current_subplanner.txt
create_conversation_collection.json
src/=
src/ERROR

# Binary/generated artifacts
*.safetensors
*.faiss
*.index.meta
*.bak
*.mp4
*.pptx
*.pdf
# TTS samples / audio scratch (e.g. tts_samples/)
*.wav
# stray text-to-image scratch output
/flux-klein.png
# Ignore stray images in docs, but keep functional icons/assets
docs/*.png
# Keep browser_extension icons and src/static tracked (small, functional)

# Local secrets for run.sh (API keys) — do not commit
.env
.venv/

# benchmarks v2 — run outputs and campaign progress
bench/*/results/
bench/campaign.json

# exec-script sandbox: the interpreter venv (rebuild with
# `uv venv sandbox_venv --python /usr/bin/python3`) and whatever the
# agents write in their sandboxed scratch dirs. `git add -f` anything
# worth keeping.
sandbox_venv/
sandbox_python/
sandbox_models/
scratch/
targets/
workflowsv2/claims_audit/engagements/*/merged/

# An engagement's materials and the client's uploads live in its directory and are never committed
workflowsv2/claims_audit/engagements/*/target/
workflowsv2/claims_audit/engagements/*/uploads/
# The demo's visitor log
workflowsv2/claims_audit/engagements/*/demo_sessions.jsonl

# Chain scripts, pid files and launcher logs written at the repo root
logs/

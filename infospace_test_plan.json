{
  "plan": [
    {
      "type": "think",
      "value": "Testing infospace core primitives: save, create, transform, and whole-value operations"
    },
    {
      "type": "save",
      "value": "Study on cognitive architecture",
      "out": "note1"
    },
    {
      "type": "save",
      "value": "Study on memory systems",
      "out": "note2"
    },
    {
      "type": "save",
      "value": "Study on planning algorithms",
      "out": "note3"
    },
    {
      "type": "create",
      "kind": "Collection",
      "value": ["$note1", "$note2", "$note3"],
      "out": "all_studies"
    },
    {
      "type": "say",
      "target": "User",
      "value": "I've created 3 study notes and collected them. Testing whole-value operations."
    },
    {
      "type": "if",
      "condition": {
        "type": "bound",
        "target": "$all_studies"
      },
      "then": [
        {
          "type": "say",
          "target": "User",
          "value": "Collection successfully created and bound."
        }
      ]
    },
    {
      "type": "save",
      "value": [1, 2, 3],
      "out": "numbers"
    },
    {
      "type": "transform",
      "target": "$numbers",
      "operation": "normalize",
      "out": "normalized"
    },
    {
      "type": "say",
      "target": "User",
      "value": "Transform test complete. All core primitives working!"
    }
  ]
}


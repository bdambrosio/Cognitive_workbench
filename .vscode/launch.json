{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug LLM Client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/llm_client.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false,
            "preLaunchTask": "setup-zenoh-environment"
        },
        {
            "name": "Debug Launcher (Joe)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/launcher.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": ["joe.yaml", "--ui", "--map-file", "forest.py"],
            "justMyCode": false,
            "stopOnEntry": false,
            "preLaunchTask": "setup-zenoh-environment"
        },
        {
            "name": "Debug Launcher (lost)",
            "type": "debugpy",
            "request": "launch",
